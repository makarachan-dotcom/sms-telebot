# AI STAND WY2.5 - Environment Configuration
# Copy this file to .env and fill in your values

# Required: Your Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Infobip SMS Configuration ──────────────────────────────────────────────
# Required for /sendsms (Infobip API).
# Obtain your API key and base URL from: https://portal.infobip.com/dev/api-keys
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=https://XXXX.api.infobip.com

# ── Rate Limiting ──────────────────────────────────────────────────────────
# Maximum SMS messages a non-admin user may send per calendar day (default: 10)
MAX_SMS_PER_DAY=10

# ── Optional: Bot Configuration ───────────────────────────────────────────
BOT_NAME=AI STAND WY2.5
BOT_VERSION=2.5.0

# Optional: Admin User IDs (comma-separated Telegram user IDs)
# Admins bypass rate limits and can use /ban, /unban, /users, /adminstats
ADMIN_USER_IDS=123456789,987654321

# Optional: Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Data Directory (SQLite DB stored here)
DATA_DIR=./data

# Optional: Log Directory
LOG_DIR=./logs

# Optional: Session Directory
SESSION_DIR=./sessions
